{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boost Focus Timer",
  "version": "../package.json",
  "identifier": "com.ttncode.boostfocustimer",
  "build": {
    "frontendDist": "../dist/extension"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Boost Focus Timer",
        "url": "popup.html",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 400,
        "visible": false,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.youtube.com; media-src 'self' data: blob:; font-src 'self' data:; frame-src https://www.youtube.com https://open.spotify.com; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_IN_RELEASE_SETUP",
      "endpoints": ["https://github.com/ttncode/boost-focus-timer/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
